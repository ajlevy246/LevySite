{
    "services": {
        "backend": {
            "root": "api/",
            "framework": "fastapi",
            "entrypoint": "main:app"
        },
        "frontend": {
            "root": "./",
            "framework": "nextjs",
            "bindings": [
                {
                    "type": "service",
                    "service": "backend",
                    "format": "url",
                    "env": "API_URL"
                }
            ]
        }
    }
}
